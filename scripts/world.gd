extends Node2D

## Region scenery: pre-rendered ground, y-sorted trees and props, a foliage
## border drawn above actors, and static collision. Geometry comes from the
## "terrain" section of data/regions.json; art is generated by tools/art/build.py.

const TILE_SIZE := 16
const MAP_WIDTH := 80
const MAP_HEIGHT := 54
const COLLISION_WORLD := 4
const ART_DIR := "res://assets/world/"
## HD art from the asset pack (tools/art/hd): same names, drawn at 1/HD_K.
const HD_DIR := "res://assets/world_hd/"
const HD_K := 2.0
const PROP_TEXTURES := {"ruins": "ruins.png", "standing_stones": "standing_stones.png", "crystal_altar": "crystal_altar.png", "sky_archive": "sky_archive.png", "mine_entrance": "mine_entrance.png"}

var region_id: String = "greenreach"
## Props may depend on the story or the world ("requires_state" / "unless_state").
var allows: Callable
var terrain: Dictionary = {}
var art_manifest: Dictionary = {}

func _ready() -> void:
	y_sort_enabled = true
	art_manifest = _load_json("res://assets/art_manifest.json")
	_build()

func configure_region(new_region_id: String) -> void:
	region_id = RegionCatalog.resolve(new_region_id)
	_wall_rects.clear()
	for child in get_children():
		remove_child(child)
		child.queue_free()
	_build()

func map_size() -> Vector2:
	var size: Variant = terrain.get("size", [MAP_WIDTH * TILE_SIZE, MAP_HEIGHT * TILE_SIZE])
	return Vector2(float(size[0]), float(size[1]))

func is_night() -> bool:
	return str(terrain.get("style", "day")) in ["night", "cave", "crypt", "magma"]

func is_cave() -> bool:
	return RegionCatalog.is_underground(str(terrain.get("style", "day")))

## Soft shadows under the scenery (stage 21).
var shadows: GroundShadows
## Things that lie flat on the ground cast no shadow.
const FLAT_WORDS := ["rug", "carpet", "path", "floor", "sigil", "plate", "tilled", "soil", "pier", "bridge", "medallion", "tracks", "stones", "lip", "puddle", "rim", "plank", "garland", "smoke", "water", "mist", "splash"]

func _build() -> void:
	terrain = RegionCatalog.terrain(region_id)
	var style := RegionCatalog.style(region_id)
	if ResourceLoader.exists(HD_DIR + region_id + "_ground.webp"):
		_add_hd_layer(region_id + "_ground.webp", -100)
	else:
		_add_layer(region_id + "_ground.png", -100)
	_add_apron()
	shadows = GroundShadows.new()
	shadows.name = "GroundShadows"
	add_child(shadows)
	if not ResourceLoader.exists(HD_DIR + region_id + "_ground.webp"):
		_add_layer(region_id + "_canopy.png", 60)
	var trees: Array = terrain.get("trees", [])
	var tree_kinds := _variants(style + "_tree_", 3)
	for index in range(trees.size()):
		var pos := _vec(trees[index])
		# Trunk base sits 10 px below the stored canopy position.
		var variant: int = absi(int(pos.x) * 7 + int(pos.y) * 13) % tree_kinds
		_add_sprite("%s_tree_%d.png" % [style, variant], pos + Vector2(0, 10), 5.0)
		_add_wall(pos + Vector2(0.0, 5.0), Vector2(10.0, 11.0))
	for prop in terrain.get("props", []):
		if allows.is_valid() and not allows.call(prop):
			continue
		var kind := str(prop.get("kind", ""))
		# "decor_*" props come from the purchased pack (tools/art/chibi.py).
		var file: String = PROP_TEXTURES.get(kind, kind + ".png" if kind.begins_with("decor_") or kind.begins_with("village_") else "")
		if not file.is_empty():
			_add_sprite(file, _vec(prop.get("position")))
			if kind in LIGHT_PROPS:
				_add_glow(_vec(prop.get("position")) + Vector2(0, -float(LIGHT_PROPS[kind])), kind == "crypt_torch")
	_add_decor_bushes(style)
	_add_ambient()
	_create_world_collisions()
	_bake_navigation()

## Bushes are pure decoration (no collision), placed deterministically away
## from trails, water and gameplay objects.
func _add_decor_bushes(style: String) -> void:
	var spots: Array = terrain.get("bushes", [])
	var kinds := _variants(style + "_bush_", 2)
	for index in range(spots.size()):
		_add_sprite("%s_bush_%d.png" % [style, index % kinds], _vec(spots[index]), 3.0)

## How many numbered variants exist (HD art may bring more than the old 2–3).
func _variants(prefix: String, fallback: int) -> int:
	if not ResourceLoader.exists(HD_DIR + prefix + "0.png"):
		return fallback
	var count := 1
	while ResourceLoader.exists(HD_DIR + prefix + str(count) + ".png"):
		count += 1
	return count

## Fireflies at night, drifting pollen by day, and glints on the water.
func _add_ambient() -> void:
	var size := map_size()
	_add_weather(size)
	var air := CPUParticles2D.new()
	air.name = "AmbientParticles"
	air.amount = 90 if is_night() else 45
	air.lifetime = 7.0
	air.preprocess = 7.0
	air.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	air.emission_rect_extents = size * 0.5
	air.position = size * 0.5
	air.direction = Vector2(1, 0.3) if not is_night() else Vector2.UP
	air.spread = 40.0 if not is_night() else 180.0
	air.initial_velocity_min = 3.0
	air.initial_velocity_max = 9.0 if not is_night() else 12.0
	air.gravity = Vector2.ZERO
	air.scale_amount_min = 1.0
	air.scale_amount_max = 2.0 if is_night() else 1.0
	var gradient := Gradient.new()
	if str(terrain.get("style", "")) in ["sky", "spires", "rift"]:
		# Wind streaks drifting across the island.
		air.direction = Vector2.RIGHT
		air.spread = 8.0
		air.initial_velocity_min = 40.0
		air.initial_velocity_max = 70.0
		air.scale_amount_max = 1.0
		gradient.offsets = PackedFloat32Array([0.0, 0.3, 0.7, 1.0])
		gradient.colors = PackedColorArray([Color(1, 1, 1, 0), Color(1, 1, 1, 0.55), Color(1, 1, 1, 0.35), Color(1, 1, 1, 0)])
	elif is_cave():
		# Crystal motes slowly rising through the dark.
		air.direction = Vector2.UP
		air.spread = 25.0
		gradient.offsets = PackedFloat32Array([0.0, 0.3, 0.7, 1.0])
		gradient.colors = PackedColorArray([Color(0.8, 0.7, 1, 0), Color(0.85, 0.75, 1, 0.9), Color(0.6, 0.85, 1, 0.6), Color(0.8, 0.7, 1, 0)])
	elif is_night():
		gradient.offsets = PackedFloat32Array([0.0, 0.2, 0.5, 0.8, 1.0])
		gradient.colors = PackedColorArray([Color(0.6, 1, 0.8, 0), Color(0.75, 1, 0.7, 1), Color(0.5, 1, 0.95, 0.2), Color(0.85, 1, 0.6, 1), Color(0.6, 1, 0.8, 0)])
	else:
		gradient.offsets = PackedFloat32Array([0.0, 0.3, 0.7, 1.0])
		gradient.colors = PackedColorArray([Color(1, 1, 0.85, 0), Color(1, 1, 0.85, 0.75), Color(1, 0.95, 0.7, 0.6), Color(1, 1, 0.85, 0)])
	air.color_ramp = gradient
	air.z_index = 50
	add_child(air)
	var points := PackedVector2Array()
	for pond in terrain.get("ponds", []):
		points.append_array(_pond_points(pond))
	if points.is_empty():
		return
	var glints := CPUParticles2D.new()
	glints.name = "WaterGlints"
	glints.amount = maxi(6, points.size() / 3)
	glints.lifetime = 1.6
	glints.preprocess = 2.0
	glints.emission_shape = CPUParticles2D.EMISSION_SHAPE_POINTS
	glints.emission_points = points
	glints.gravity = Vector2.ZERO
	glints.initial_velocity_min = 0.0
	glints.initial_velocity_max = 2.0
	glints.direction = Vector2.RIGHT
	glints.spread = 10.0
	glints.scale_amount_min = 1.0
	glints.scale_amount_max = 2.0
	var shine := Gradient.new()
	shine.offsets = PackedFloat32Array([0.0, 0.5, 1.0])
	shine.colors = PackedColorArray([Color(1, 1, 1, 0), Color(0.9, 1, 1, 0.95), Color(1, 1, 1, 0)])
	glints.color_ramp = shine
	glints.z_index = -90
	add_child(glints)

func _pond_points(pond: Dictionary) -> PackedVector2Array:
	var result := PackedVector2Array()
	var rng := RandomNumberGenerator.new()
	rng.seed = 4242
	for i in range(40):
		if pond.has("rect"):
			var r: Array = pond["rect"]
			result.append(Vector2(float(r[0]) + float(r[2]) * rng.randf_range(0.15, 0.85), float(r[1]) + float(r[3]) * rng.randf_range(0.25, 0.85)))
		elif pond.has("circle"):
			var c: Array = pond["circle"]
			var angle := rng.randf() * TAU
			var dist := sqrt(rng.randf()) * float(c[2]) * 0.75
			result.append(Vector2(float(c[0]), float(c[1])) + Vector2(cos(angle), sin(angle)) * dist)
	return result

## Weather by land: embers and ash over the Ashen Waste, snow on the Pass.
func _add_weather(size: Vector2) -> void:
	var style := str(terrain.get("style", "day"))
	if style == "ash":
		_weather("Embers", size, 70, 5.0, Vector2.UP, Vector2(0, -14), 10.0, 26.0, Color(1.0, 0.62, 0.2), 1.0, 2.0)
		_weather("Ash", size, 120, 9.0, Vector2(0.3, 1.0), Vector2(4, 10), 6.0, 14.0, Color(0.7, 0.66, 0.64, 0.8), 1.0, 1.5)
	elif style == "haven":
		_weather("Petals", size, 60, 9.0, Vector2(1.0, 0.6), Vector2(3, 6), 8.0, 18.0, Color(1.0, 0.75, 0.84, 0.9), 1.0, 2.0)
	elif style == "mountain":
		_weather("Snow", size, 160, 10.0, Vector2(0.25, 1.0), Vector2(6, 12), 10.0, 22.0, Color(0.96, 0.98, 1.0, 0.9), 1.0, 2.0)

func _weather(id: String, size: Vector2, amount: int, life: float, direction: Vector2, gravity: Vector2, speed_min: float, speed_max: float, color: Color, scale_min: float, scale_max: float) -> void:
	var particles := CPUParticles2D.new()
	particles.name = "Weather" + id
	particles.amount = amount
	particles.lifetime = life
	particles.preprocess = life
	particles.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	particles.emission_rect_extents = size * 0.5
	particles.position = size * 0.5
	particles.direction = direction
	particles.spread = 20.0
	particles.gravity = gravity
	particles.initial_velocity_min = speed_min
	particles.initial_velocity_max = speed_max
	particles.scale_amount_min = scale_min
	particles.scale_amount_max = scale_max
	var fade := Gradient.new()
	fade.set_color(0, Color(color, 0.0))
	fade.add_point(0.2, color)
	fade.add_point(0.8, color)
	fade.set_color(fade.get_point_count() - 1, Color(color, 0.0))
	particles.color_ramp = fade
	particles.z_index = 50
	add_child(particles)

## Floating island: the sky, cliffs and bridges around the map (four strips
## from tools/art/apron.py), clouds drifting below and cloud shadows above.
const APRON := 160

func has_apron() -> bool:
	return ResourceLoader.exists(ART_DIR + region_id + "_apron_top.png") or ResourceLoader.exists(HD_DIR + region_id + "_apron_top.webp")

func _add_apron() -> void:
	if not has_apron():
		return
	var size := map_size()
	var places := {"top": Vector2(-APRON, -APRON), "bottom": Vector2(-APRON, size.y), "left": Vector2(-APRON, 0), "right": Vector2(size.x, 0)}
	for side in places:
		var hd_file := HD_DIR + "%s_apron_%s.webp" % [region_id, side]
		var hd := ResourceLoader.exists(hd_file)
		var texture: Texture2D = (load(hd_file) as Texture2D) if hd else _texture("%s_apron_%s.png" % [region_id, side])
		if texture == null:
			continue
		var sprite := Sprite2D.new()
		sprite.name = "Apron_" + side
		sprite.texture = texture
		sprite.centered = false
		sprite.position = places[side]
		sprite.z_index = -110
		sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR if hd else CanvasItem.TEXTURE_FILTER_NEAREST
		if hd:
			sprite.scale = Vector2.ONE / HD_K
		add_child(sprite)
	# Sky islands smaller than the map: the sky and cliffs inside the map edge.
	var inner_file := HD_DIR + region_id + "_apron_inner.webp"
	if ResourceLoader.exists(inner_file):
		var inner := Sprite2D.new()
		inner.name = "Apron_inner"
		inner.texture = load(inner_file) as Texture2D
		inner.centered = false
		inner.scale = Vector2.ONE / HD_K
		inner.z_index = -99
		inner.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		add_child(inner)
	_add_sky_landmarks()
	var drift := Node2D.new()
	drift.name = "SkyClouds"
	drift.z_index = -105
	drift.set_script(preload("res://scripts/sky_clouds.gd"))
	drift.set("area", Rect2(-APRON, -APRON, size.x + APRON * 2, size.y + APRON * 2))
	drift.set("night", is_night())
	drift.set("texture_paths", terrain.get("sky_clouds", []))
	add_child(drift)
	var shadows := Node2D.new()
	shadows.name = "CloudShadows"
	shadows.z_index = -90
	shadows.set_script(preload("res://scripts/cloud_shadows.gd"))
	shadows.set("area", Rect2(Vector2.ZERO, size))
	add_child(shadows)

## Distant landmarks sit above the baked sky, below moving clouds and cliffs.
func _add_sky_landmarks() -> void:
	for landmark in terrain.get("sky_landmarks", []):
		var texture := WorldArt.texture(str(landmark["texture"]))
		if texture == null:
			continue
		var sprite := Sprite2D.new()
		sprite.texture = texture
		sprite.position = _vec(landmark["position"])
		sprite.scale = Vector2.ONE * float(landmark["scale"])
		sprite.z_index = -107
		sprite.modulate.a = 0.86
		sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
		add_child(sprite)

func _add_layer(file: String, layer_z: int) -> void:
	var texture := _texture(file)
	if texture == null:
		return
	var sprite := Sprite2D.new()
	sprite.texture = texture
	sprite.centered = false
	sprite.z_index = layer_z
	sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	add_child(sprite)

func _add_hd_layer(file: String, layer_z: int) -> void:
	var texture := load(HD_DIR + file) as Texture2D
	if texture == null:
		return
	var sprite := Sprite2D.new()
	sprite.name = "GroundHD"
	sprite.texture = texture
	sprite.centered = false
	sprite.scale = Vector2.ONE / HD_K
	sprite.z_index = layer_z
	sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	add_child(sprite)

## Foliage sways in the wind (assets/shaders/foliage_sway.gdshader); one
## material per strength is shared by every sprite.
const SWAY_SHADER := "res://assets/shaders/foliage_sway.gdshader"
static var _sway_materials: Dictionary = {}

static var _sway_clock: float = 0.0

func _process(delta: float) -> void:
	# Pauses with the tree: the foliage stands still in the pause menu.
	_sway_clock += delta
	for material in _sway_materials.values():
		(material as ShaderMaterial).set_shader_parameter("clock", _sway_clock)

static func sway_material(strength: float) -> ShaderMaterial:
	if not _sway_materials.has(strength):
		var material := ShaderMaterial.new()
		material.shader = load(SWAY_SHADER)
		material.set_shader_parameter("strength", strength)
		_sway_materials[strength] = material
	return _sway_materials[strength]

func _add_sprite(file: String, base: Vector2, sway: float = 0.0) -> void:
	var hd := ResourceLoader.exists(HD_DIR + file)
	var texture: Texture2D = (load(HD_DIR + file) as Texture2D) if hd else _texture(file)
	if texture == null:
		return
	var sprite := Sprite2D.new()
	sprite.texture = texture
	sprite.centered = false
	sprite.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR if hd else CanvasItem.TEXTURE_FILTER_NEAREST
	if hd:
		sprite.scale = Vector2.ONE / HD_K
	var key := ("world_hd/" if hd else "world/") + file
	var origin: Variant = art_manifest.get(key, {}).get("origin", [texture.get_width() / 2, texture.get_height()])
	sprite.offset = -Vector2(float(origin[0]), float(origin[1]))
	sprite.position = base
	if sway > 0.0 and RegionCatalog.style(region_id) not in ["cave", "crypt", "magma"]:
		sprite.material = sway_material(sway)
	add_child(sprite)
	if shadows != null:
		var size: Vector2 = texture.get_size() * sprite.scale
		var flat := size.y < 12.0
		for word in FLAT_WORDS:
			flat = flat or file.contains(word)
		if not flat:
			shadows.add_object(base, size, file.contains("_tree_"))

## Lamps and torches cast warm light (seen at night and underground).
const LIGHT_PROPS := {"village_lamp": 26, "crypt_torch": 18, "decor_harbor_mooring_beacon": 24}
static var _glow_texture: GradientTexture2D

func _add_glow(at: Vector2, always: bool) -> void:
	if _glow_texture == null:
		var ramp := Gradient.new()
		ramp.set_color(0, Color(1, 1, 1, 1))
		ramp.set_color(1, Color(1, 1, 1, 0))
		_glow_texture = GradientTexture2D.new()
		_glow_texture.gradient = ramp
		_glow_texture.fill = GradientTexture2D.FILL_RADIAL
		_glow_texture.fill_from = Vector2(0.5, 0.5)
		_glow_texture.fill_to = Vector2(1.0, 0.5)
		_glow_texture.width = 128
		_glow_texture.height = 128
	var light := PointLight2D.new()
	light.texture = _glow_texture
	light.texture_scale = 1.3
	light.color = Color(1.0, 0.78, 0.45)
	light.energy = 0.9 if always else 0.0
	light.position = at
	light.add_to_group("night_lights" if not always else "torch_lights")
	add_child(light)

func _texture(file: String) -> Texture2D:
	var path := ART_DIR + file
	if not ResourceLoader.exists(path):
		push_warning("Нет текстуры мира: " + path)
		return null
	return load(path) as Texture2D

## A separate world collision layer prevents actors walking through scenery.
func _create_world_collisions() -> void:
	var size := map_size()
	# Thin perimeter walls are centered just outside the playable area.
	_add_wall(Vector2(size.x * 0.5, -8.0), Vector2(size.x + 32.0, 16.0))
	_add_wall(Vector2(size.x * 0.5, size.y + 8.0), Vector2(size.x + 32.0, 16.0))
	_add_wall(Vector2(-8.0, size.y * 0.5), Vector2(16.0, size.y + 32.0))
	_add_wall(Vector2(size.x + 8.0, size.y * 0.5), Vector2(16.0, size.y + 32.0))
	# Islands: invisible walls at the coastline keep the hero off the sky.
	var margin := float(terrain.get("edge_margin", 0))
	if margin > 0.0:
		_add_wall(Vector2(size.x * 0.5, margin * 0.5), Vector2(size.x, margin))
		_add_wall(Vector2(size.x * 0.5, size.y - margin * 0.5), Vector2(size.x, margin))
		_add_wall(Vector2(margin * 0.5, size.y * 0.5), Vector2(margin, size.y))
		_add_wall(Vector2(size.x - margin * 0.5, size.y * 0.5), Vector2(margin, size.y))
	for blocker in terrain.get("blockers", []):
		_add_wall(_vec(blocker.get("center")), _vec(blocker.get("size"), Vector2(16, 16)))
	_add_water_walls()

## Owner's list №39: nobody walks on lakes, bogs or lava. Each pool is cut
## into 8 px rows of solid water a little inside the shore (the shore stays
## walkable for fishing); where a trail crosses the water — a ford or a
## bridge — the row is left open.
const WATER_INSET := 10.0
const WATER_STEP := 8.0

func _add_water_walls() -> void:
	var trails: Array = terrain.get("trails", [])
	# Piers stand over the water: walkable.
	var piers: Array[Rect2] = []
	for prop in terrain.get("props", []):
		if str(prop.get("kind", "")).contains("pier"):
			piers.append(Rect2(_vec(prop.get("position")) - Vector2(58, 22), Vector2(116, 32)))
	# Walls already there (a lake fenced by a blocker) need no water strips.
	var walls := _wall_rects.duplicate()
	for pond in terrain.get("ponds", []):
		var box := _pond_box(pond)
		if box.size.x <= 0.0:
			continue
		var y := box.position.y + WATER_STEP * 0.5
		while y < box.end.y:
			var run_start := NAN
			var x := box.position.x + WATER_STEP * 0.5
			while x <= box.end.x + WATER_STEP:
				var cell := Vector2(x, y)
				var solid := x < box.end.x and _deep_water(pond, cell) and not _near_trail(trails, cell, 14.0) and not piers.any(func(r: Rect2) -> bool: return r.has_point(cell)) and not walls.any(func(r: Rect2) -> bool: return r.grow(WATER_STEP).has_point(cell))
				if solid and is_nan(run_start):
					run_start = x
				elif not solid and not is_nan(run_start):
					var left := run_start - WATER_STEP * 0.5
					var right := x - WATER_STEP * 0.5
					_add_wall(Vector2((left + right) * 0.5, y), Vector2(right - left, WATER_STEP))
					run_start = NAN
				x += WATER_STEP
			y += WATER_STEP

func _pond_box(pond: Dictionary) -> Rect2:
	if pond.has("rect"):
		var r: Array = pond["rect"]
		return Rect2(float(r[0]), float(r[1]), float(r[2]), float(r[3]))
	if pond.has("circle"):
		var c: Array = pond["circle"]
		var radius := float(c[2])
		return Rect2(float(c[0]) - radius, float(c[1]) - radius, radius * 2.0, radius * 2.0)
	return Rect2()

## True a little inside the shore (the art wobbles the edge a few pixels).
func _deep_water(pond: Dictionary, at: Vector2) -> bool:
	if pond.has("rect"):
		var r: Array = pond["rect"]
		var half := Vector2(float(r[2]), float(r[3])) * 0.5
		var center := Vector2(float(r[0]), float(r[1])) + half
		var inner := half - Vector2(WATER_INSET, WATER_INSET)
		if inner.x <= 0.0 or inner.y <= 0.0:
			return false
		return pow(absf((at.x - center.x) / inner.x), 3.2) + pow(absf((at.y - center.y) / inner.y), 3.2) <= 1.0
	var c: Array = pond["circle"]
	var radius := float(c[2]) - WATER_INSET
	if radius <= 4.0:
		return false
	return Vector2(at.x - float(c[0]), (at.y - float(c[1])) * 1.08).length() <= radius

static func _near_trail(trails: Array, at: Vector2, distance: float) -> bool:
	for trail in trails:
		var points: Array = trail
		for index in range(points.size() - 1):
			var a := _vec(points[index])
			var b := _vec(points[index + 1])
			if Geometry2D.get_closest_point_to_segment(at, a, b).distance_to(at) < distance:
				return true
	return false

## Every solid rectangle, kept for the navigation mesh.
var _wall_rects: Array[Rect2] = []
var navigation: NavigationRegion2D

## Enemies find their way around trees and walls (tech debt from Этап 5):
## the walkable area is the map (inside the island edge) minus every wall.
func _bake_navigation() -> void:
	var size := map_size()
	var margin := float(terrain.get("edge_margin", 0))
	var source := NavigationMeshSourceGeometryData2D.new()
	source.add_traversable_outline(PackedVector2Array([Vector2(margin, margin), Vector2(size.x - margin, margin), Vector2(size.x - margin, size.y - margin), Vector2(margin, size.y - margin)]))
	for rect in _wall_rects:
		source.add_obstruction_outline(PackedVector2Array([rect.position, Vector2(rect.end.x, rect.position.y), rect.end, Vector2(rect.position.x, rect.end.y)]))
	var polygon := NavigationPolygon.new()
	polygon.agent_radius = 7.0
	polygon.parsed_geometry_type = NavigationPolygon.PARSED_GEOMETRY_STATIC_COLLIDERS
	NavigationServer2D.bake_from_source_geometry_data(polygon, source)
	navigation = NavigationRegion2D.new()
	navigation.name = "Navigation"
	navigation.navigation_polygon = polygon
	add_child(navigation)

func _add_wall(center: Vector2, size: Vector2) -> void:
	_wall_rects.append(Rect2(center - size * 0.5, size))
	var body := StaticBody2D.new()
	body.collision_layer = COLLISION_WORLD
	body.collision_mask = 0
	body.position = center
	var collider := CollisionShape2D.new()
	var shape := RectangleShape2D.new()
	shape.size = size
	collider.shape = shape
	body.add_child(collider)
	add_child(body)

static func _vec(value: Variant, fallback: Vector2 = Vector2.ZERO) -> Vector2:
	if value is Array and value.size() == 2:
		return Vector2(float(value[0]), float(value[1]))
	return fallback

static func _load_json(path: String) -> Dictionary:
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		push_warning("Не найден файл: " + path)
		return {}
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	return parsed if parsed is Dictionary else {}
