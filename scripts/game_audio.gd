extends Node
class_name GameAudio

## Sound effects and music. Static helpers create one GameAudio node under the
## scene-tree root on first use. Sounds live in assets/audio (generated by
## tools/audio/build_audio.py). Volumes come from GameSettings (0..1).

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const VOICES := 12
const MIN_REPEAT := 0.045
const FADE := 1.2

static var _instance: GameAudio

var _voices: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _streams: Dictionary = {}
var _last_played: Dictionary = {}
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var current_track: String = ""

static func instance() -> GameAudio:
	if _instance != null and is_instance_valid(_instance):
		return _instance
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null:
		return null
	_instance = GameAudio.new()
	_instance.name = "GameAudio"
	tree.root.add_child.call_deferred(_instance)
	_instance._setup()
	return _instance

## Plays a one-shot effect; small random pitch keeps repeats lively.
static func play(sound: String, volume_db: float = 0.0, pitch_jitter: float = 0.06) -> void:
	var audio := instance()
	if audio != null:
		audio._play(sound, volume_db, pitch_jitter)

## Crossfades to a looping track ("" stops the music).
static func music(track: String) -> void:
	var audio := instance()
	if audio != null:
		audio._music(track)

static func apply_volumes() -> void:
	var audio := instance()
	if audio != null:
		audio._apply_volumes()

func _setup() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "SFX"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var index := AudioServer.bus_count - 1
			AudioServer.set_bus_name(index, bus)
			AudioServer.set_bus_send(index, "Master")
	for i in range(VOICES):
		var voice := AudioStreamPlayer.new()
		voice.bus = "SFX"
		add_child(voice)
		_voices.append(voice)
	_music_a = AudioStreamPlayer.new()
	_music_b = AudioStreamPlayer.new()
	for player in [_music_a, _music_b]:
		player.bus = "Music"
		player.volume_db = -80.0
		add_child(player)
	_apply_volumes()

func _apply_volumes() -> void:
	_set_bus_volume("Music", GameSettings.get_float("music_volume"))
	_set_bus_volume("SFX", GameSettings.get_float("sfx_volume"))

func _set_bus_volume(bus: String, value: float) -> void:
	var index := AudioServer.get_bus_index(bus)
	if index == -1:
		return
	AudioServer.set_bus_mute(index, value <= 0.001)
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(value, 0.001)))

func _stream(path: String) -> AudioStream:
	if not _streams.has(path):
		_streams[path] = load(path) if ResourceLoader.exists(path) else null
	return _streams[path]

func _play(sound: String, volume_db: float, pitch_jitter: float) -> void:
	if not is_inside_tree():
		return
	var stream := _stream(SFX_DIR + sound + ".wav")
	if stream == null:
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last_played.get(sound, -1.0)) < MIN_REPEAT:
		return
	_last_played[sound] = now
	var voice := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % _voices.size()
	voice.stream = stream
	voice.volume_db = volume_db
	voice.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	voice.play()

func _music(track: String) -> void:
	if track == current_track:
		return
	current_track = track
	if not is_inside_tree():
		# Created this frame (deferred add_child): start once in the tree.
		current_track = ""
		_music.call_deferred(track)
		return
	var outgoing := _music_a if _music_a.playing else _music_b
	var incoming := _music_b if outgoing == _music_a else _music_a
	if outgoing.playing:
		var fade_out := create_tween()
		fade_out.tween_property(outgoing, "volume_db", -80.0, FADE)
		fade_out.tween_callback(outgoing.stop)
	if track.is_empty():
		return
	var stream := _stream(MUSIC_DIR + track + ".ogg")
	if stream == null:
		return
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	incoming.stream = stream
	incoming.volume_db = -30.0
	incoming.play()
	var fade_in := create_tween()
	fade_in.tween_property(incoming, "volume_db", 0.0, FADE)

func _exit_tree() -> void:
	for player in [_music_a, _music_b]:
		player.stop()
		player.stream = null
	for voice in _voices:
		voice.stream = null
	_streams.clear()
	if _instance == self:
		_instance = null
