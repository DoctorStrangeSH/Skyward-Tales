config_version=5

[application]
config/name="Skyward Tales"
run/main_scene="res://scenes/title_menu.tscn"
config/version="0.3.0"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui_theme.tres"

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65), Object(InputEventKey, "physical_keycode": 4194311)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68), Object(InputEventKey, "physical_keycode": 4194313)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87), Object(InputEventKey, "physical_keycode": 4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83), Object(InputEventKey, "physical_keycode": 4194322)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index": 1)]
}
cast_spell={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index": 2)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 32)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194325)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 4194305)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.08, 1)
